FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements.lock ./requirements.lock
RUN python -m pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    --requirement requirements.lock \
    && groupadd --gid 10001 app \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --no-create-home \
        --shell /usr/sbin/nologin \
        app

# Deliberately copy only runtime code. No data directory or labels enter this image.
COPY --chown=10001:10001 src/common/ ./src/common/
COPY --chown=10001:10001 src/guardrail/ ./src/guardrail/

USER 10001:10001
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "guardrail.app:app", "--host", "0.0.0.0", "--port", "8080"]
